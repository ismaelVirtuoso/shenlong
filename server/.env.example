# Copie para .env e preencha. Sem chaves, rode `npm run mock` (respostas de teste, TTS/STT indisponíveis -> app usa fallbacks).
PORT=8787

# STT + TTS (e chat se LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Chat padrão
ANTHROPIC_API_KEY=

LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_CHAT_MODEL=gpt-4o-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=onyx

# Opcional: se definido, o app precisa enviar o mesmo valor no header x-app-token
APP_TOKEN=
