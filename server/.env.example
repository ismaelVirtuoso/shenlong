# Copie para .env e preencha. Sem chave, tudo funciona localmente: Whisper (ouvir) + Piper (voz) + conversa por regras.
# `npm run mock` usa respostas de teste.
PORT=8787

# IA: somente Gemini (https://aistudio.google.com/apikey). Uma chave cobre conversa, ouvir e voz.
GEMINI_API_KEY=

GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Charon
# auto | gemini | piper  (auto = Gemini se houver chave, senão Piper)
TTS_PROVIDER=auto

# Opcional: se definido, o app precisa enviar o mesmo valor no header x-app-token
APP_TOKEN=
